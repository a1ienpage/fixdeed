# The core free product runs without keys or external AI calls.
# Hosted Stripe Sandbox checkout requires the server-only test key below.
# Optional: use a separate build cache when a development server is running.
# FIXDEED_BUILD_DIR=.next-build

# Server-only Stripe Sandbox. Never use a live key or commit a real secret.
STRIPE_SECRET_KEY=
# Production defaults to https://fixdeed.vercel.app
APP_BASE_URL=
